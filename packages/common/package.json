{
  "name": "@big-bus/common",
  "version": "1.0.0",
  "description": "Common utilities and helpers for Big Bus services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "keywords": [
    "big-bus",
    "common",
    "utilities"
  ],
  "author": "Big Bus Team",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^10.4.20",
    "@sentry/node": "^10.25.0",
    "@sentry/profiling-node": "^10.25.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "rxjs": "^7.8.1",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/*.spec.ts"],
    "moduleFileExtensions": ["ts", "js", "json"]
  }
}
