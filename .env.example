# Zalo OA
ZALO_OA_ID=
ZALO_OA_SECRET=
ZALO_OA_ACCESS_TOKEN=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
