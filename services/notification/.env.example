# Service Configuration
NODE_ENV=development
PORT=3005
SERVICE_NAME=notification-service

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE_EMAIL=notifications.email
RABBITMQ_QUEUE_SMS=notifications.sms
RABBITMQ_QUEUE_PUSH=notifications.push
RABBITMQ_QUEUE_ZALO=notifications.zalo

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Big Bus
SMTP_FROM_EMAIL=noreply@bigbus.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SMS Configuration (Alternative - Vietnam providers)
SMS_PROVIDER=twilio # or esms, vietguys
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRAND_NAME=BIGBUS

# Push Notification (Firebase)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Zalo OA Configuration
ZALO_OA_ID=your-oa-id
ZALO_OA_SECRET=your-oa-secret
ZALO_OA_REFRESH_TOKEN=your-refresh-token
ZALO_API_URL=https://openapi.zalo.me/v2.0

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Template Configuration
TEMPLATE_DIR=./src/common/templates
